@using SirketYonetim.Models.Product
@model ProductCreateViewModel

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow rounded-4 border-0">
            <div class="card-body p-4">
                <h2 class="text-center mb-2">Create Product</h2>
                <div class="text-center text-muted mb-2">
                    ⌭ Product Details
                </div>
                <hr class="mb-2" />
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ProductName" class="form-label fw-semibold"></label>
                        <input asp-for="ProductName" class="form-control" placeholder="Product Name" />
                        <span asp-validation-for="ProductName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProductPrice" class="form-label fw-semibold"></label>
                        <input asp-for="ProductPrice" type="number" step="0.01" class="form-control" placeholder="Product Price" />
                        <span asp-validation-for="ProductPrice" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProductStock" class="form-label fw-semibold"></label>
                        <input asp-for="ProductStock" type="number" class="form-control" placeholder="Product Stock" />
                        <span asp-validation-for="ProductStock" class="text-danger small"></span>
                    </div>
                    <hr class="mb-4" />

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-outline-info btn-lg">Create</button>
                    </div>

                    <div class="text-center">
                        <a asp-action="List" class="btn btn-outline-secondary btn-sm">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>