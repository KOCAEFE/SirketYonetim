@using SirketYonetim.Models.Employee
@model EmployeeCreateViewModel

<div class="row">
    <div class="col-md-12">
        <div class="card shadow rounded-4 border-0">
            <div class="card-body px-5 py-4">
                <h2 class="text-center mb-2">Create Employee</h2>
                <div class="text-center text-muted mb-2">
                    ⌭ Employee Details
                </div>
                <hr class="mb-2" />
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold"></label>
                        <input asp-for="UserName" class="form-control" placeholder="Username" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="(5XX) XXX-XXXX" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <hr class="mb-4" />

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-outline-info btn-lg">Create</button>
                    </div>

                    <div class="text-center">
                        <a asp-action="List" class="btn btn-outline-secondary btn-sm">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>