@using SirketYonetim.Models.Customer
@model CustomerDetailViewModel

<h2 class="mt-3">Customer Detail</h2>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">@Model.FullName</h5>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>PhoneNumber:</strong> @Model.PhoneNumber</p>
        <p><strong>CreatedDate:</strong> @Model.CreatedDate.ToShortDateString()</p>
        @if (Model.UpdatedDate.HasValue)
        {
            <p><strong>UpdatedDate:</strong> @Model.UpdatedDate.Value.ToShortDateString()</p>
        }
    </div>
</div>

<a asp-action="List" class="btn btn-secondary mt-3">Back</a>